##data filtration 

def DNA_complement(seq):
    complement=''
    for letter in seq:
        if letter=='A':
            complement+='T'
        if letter=='T':
            complement+='A'
        if letter=='C':
            complement+='G'
        if letter=='G':
            complement+='C'
    return complement

#translation into 6 frames

def translate(seq):

    table = {
        'ATA':'I', 'ATC':'I', 'ATT':'I', 'ATG':'M',
        'ACA':'T', 'ACC':'T', 'ACG':'T', 'ACT':'T',
        'AAC':'N', 'AAT':'N', 'AAA':'K', 'AAG':'K',
        'AGC':'S', 'AGT':'S', 'AGA':'R', 'AGG':'R',                 
        'CTA':'L', 'CTC':'L', 'CTG':'L', 'CTT':'L',
        'CCA':'P', 'CCC':'P', 'CCG':'P', 'CCT':'P',
        'CAC':'H', 'CAT':'H', 'CAA':'Q', 'CAG':'Q',
        'CGA':'R', 'CGC':'R', 'CGG':'R', 'CGT':'R',
        'GTA':'V', 'GTC':'V', 'GTG':'V', 'GTT':'V',
        'GCA':'A', 'GCC':'A', 'GCG':'A', 'GCT':'A',
        'GAC':'D', 'GAT':'D', 'GAA':'E', 'GAG':'E',
        'GGA':'G', 'GGC':'G', 'GGG':'G', 'GGT':'G',
        'TCA':'S', 'TCC':'S', 'TCG':'S', 'TCT':'S',
        'TTC':'F', 'TTT':'F', 'TTA':'L', 'TTG':'L',
        'TAC':'Y', 'TAT':'Y', 'TAA':'_', 'TAG':'_',
        'TGC':'C', 'TGT':'C', 'TGA':'_', 'TGG':'W',
        'GTn':'V', 'GCn':'A', 'GGn':'G', 'TCn':'S',
        'ACn':'T', 'CTn':'L', 'CCn':'P', 'CGn':'R',
    }
    seq1=seq[0::]
    seq2=seq1[1::]
    seq3=seq1[2::]
    complement_seq=DNA_complement(seq1)
    
    rev_seq1 = complement_seq[::-1]
    rev_seq2 = rev_seq1[1::]
    rev_seq3 = rev_seq1[2::]
        
    frames=[seq1,seq2,seq3,rev_seq1,rev_seq2,rev_seq3]
    prot_frames=[]
    for f in frames:
        
        protein =""
        #if len(f)%3==1:
            #fr=f[:-1:]
        #elif len(f)%3==2:
            #fr=f[:-2:]
        #else:
            #fr=f
        
        for i in range(0, len(f), 3):
            codon = f[i:i + 3]
            if codon in table.keys(): 
                protein+= table[codon]
            else:
                protein+= 'X'
        prot_frames.append(protein)
    
    return prot_frames

#search of reading frames

def framecut(frames, wide=3):
    end_mode=False
    cutted_frames=[]
    for fr in frames:
        end_mode=False
        frames_list=[]
        
        start=0
        while end_mode==False:
            fr1=fr[start:]
            if 'M' in fr1:
                
                beg1=fr1.find('M')
                beg=beg1+start
                beg_fr=fr1[beg1:]
                if '_' in beg_fr:
                    
                    end1=fr1.find('_', beg1)
                    end=end1+start
                    
                else:
                    end=len(fr)
                    end_mode=True
                    
                subframe=fr[beg:end]
                if end_mode==True:
                    subframe+='!'
                else:
                    frames_list.append([subframe,beg,end])
                
                start=end+1
                
            else:
                frames_list.append(['',0,0])
                end_mode=True
                
        fl= frames_list
        max_frame=['',0,0]
        for frame in fl:
            if len(frame[0])>25 and len(frame[0])>len(max_frame[0]):
                max_frame=frame
                
        cutted_frames.append(max_frame)
  
    
        
    max_result=cutted_frames[0]
    res_ind=0
    for ind in range(1,wide):
        if len(cutted_frames[ind][0])>len(max_result[0]):
            #if len((max_result[0]))>40:
                #print(max_result, res_ind)
                #print(cutted_frames[ind],ind,'\n')
            max_result=cutted_frames[ind]
            res_ind=ind
        
    return max_result,res_ind


#commented array generation

def comments(cutted_frames):
    commented_frames=[]
    
    if cutted_frames[0]!='Empty frame':
        commented_frames.append('forward1: '+cutted_frames[0]+'\n')
    if cutted_frames[1]!='Empty frame':
        commented_frames.append('forward2: '+cutted_frames[1]+'\n')
    if cutted_frames[2]!='Empty frame':
        commented_frames.append('forward3: '+cutted_frames[2]+'\n')
    if cutted_frames[3]!='Empty frame':
        commented_frames.append('reverse1: '+cutted_frames[3]+'\n')
    if cutted_frames[4]!='Empty frame':
        commented_frames.append('reverse2: '+cutted_frames[4]+'\n')
    if cutted_frames[5]!='Empty frame':
        commented_frames.append('reverse3: '+cutted_frames[5]+'\n')
    return commented_frames

#cutoff 

def seqcut(seq):
    beg=0
    end=len(seq)
    q1=seq[0:int(len(seq)/4)]

    if 'n' in q1:
        beg=int(len(seq)/4)-q1[::-1].find('n')
    
    q4=seq[int(3*len(seq)/4):]
    if 'n' in q4:
        end=int(3*len(seq)/4)+q4.find('n')
    seq=seq[beg:end]
    
    #print(seq)
    while 'CCACGCGTCC' in seq:
        seq=seq[10:]
        
    while 'GGACGCGTGGG'in seq:
        seq=seq[11:]
        
    return seq


