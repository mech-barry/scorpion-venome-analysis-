def Blast_extraction(Blast_file_name):
    quality_k=[]
    names=[]
    codes=[]
    annotation_status=[]
    list_check=False
    with open(Blast_file_name, 'r') as infile:
        for line in infile:
            if line.startswith('Query #'):
                samp=line.split(sep=' ')[2]
                samp_main=samp.split('.')[0] + '.' + samp.split('.')[1] + '.' + samp.split('.')[2]
                names.append(samp_main)
            if line.startswith('No significant similarity found'):
                annotation_status+=[0]
                quality_k+=[0]
                codes+=['']
            if list_check==True:
                #print (counter)
                cover=int(line[122:126].split('%')[0])/100
                ident=float(line[134:140])/100
                code=line[152:162].split(' ')[0]
                quality=ident*cover
                quality_k.append(quality)
                codes+=[code]
            
                list_check=False
            if line.startswith('Description'):
                list_check=True
                annotation_status+=[1]
    blast_first_sample_data=[names,annotation_status,quality_k,codes]    
    return(blast_first_sample_data)

